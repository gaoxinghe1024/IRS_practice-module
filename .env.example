# AniLogic environment example. Copy to .env (never commit .env) or export these variables.
# Settings layering: configs/base.yaml -> configs/<mode>.yaml -> ANILOGIC_<SECTION>__<KEY> variables.

# Dataset mode: synthetic (fictional demo world) or real (Kaggle MAL 2023 snapshot under data/raw/mal_2023/)
ANILOGIC_DATASET_MODE=synthetic

# Serve over HTTPS? then mark cookies Secure
# ANILOGIC_APP__SECURE_COOKIES=true

# --- Optional LLM for chat answers (without it chat runs in local evidence-template mode) ---
# OpenAI-compatible endpoint (e.g. the DeepSeek configuration used by the original template):
# ANILOGIC_LLM__PROVIDER=openai_compatible
# ANILOGIC_LLM__BASE_URL=https://api.deepseek.com/v1
# ANILOGIC_LLM__MODEL=deepseek-chat
# Anthropic (official SDK; install the `llm` extra). Server-side refusal fallback is enabled by the adapter.
# ANILOGIC_LLM__PROVIDER=anthropic
# ANILOGIC_LLM__MODEL=claude-opus-5-5
# ANILOGIC_LLM__EFFORT=low
# Secret: read only from the environment, never from YAML
# ANILOGIC_LLM_API_KEY=replace-me
# Dated prices (USD per million tokens) to report per-request cost; leave unset -> cost reported as unknown
# ANILOGIC_LLM__PRICE_PER_MTOK_INPUT=
# ANILOGIC_LLM__PRICE_PER_MTOK_OUTPUT=
# ANILOGIC_LLM__PRICE_AS_OF=2026-09-30

# Real-data laptop sampling (null = all offline users); recorded in the split report
# ANILOGIC_PIPELINE__SAMPLE_USERS_FRACTION=0.25

# Hugging Face cache location for the BGE model (downloaded explicitly by `make build-resources`)
# HF_HOME=~/.cache/huggingface
