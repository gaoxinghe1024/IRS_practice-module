# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# === Local databases (rebuilt by `make seed` / activation) ===
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
var/

# === Data: raw Kaggle files, caches and generated/processed data are never committed ===
data/raw/
data/enriched/
data/processed/
data/synthetic/
!data/**/README.md
!data/**/.gitkeep

# === Trained models / indexes (reproducible from the pipelines) ===
artifacts/

# === Evaluation: large per-case files stay local; reports and metrics are committed ===
evaluation/runs/**/predictions.csv
evaluation/runs/**/per_case.jsonl

# === Browser test output ===
test-results/
playwright-report/

# === System / editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# === Environment variables (secrets) ===
.env
.env.*
!.env.example
